# ============================================================================
# KTS INTERNAL MULTI-BRANCH CRM/ERP - ENVIRONMENT CONFIGURATION
# Architecture Ref: https://tai-lieu-network.vercel.app/
# ============================================================================

# Server Configuration (HQ Server VLAN 20: 10.10.20.100:4000)
NODE_ENV=development
PORT=4000
APP_NAME="KTS Internal CRM"
CLIENT_URL="http://crm.noibo.local"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://crm.noibo.local,http://10.10.20.100"

# PostgreSQL Database (Docker internal 10.10.20.100:5432)
DATABASE_URL="postgresql://kts_admin:kts_secret_2026@localhost:5433/kts_crm?schema=public"

# JWT Security Configuration
JWT_ACCESS_SECRET="kts_crm_access_secret_key_change_in_production_2026"
JWT_REFRESH_SECRET="kts_crm_refresh_secret_key_change_in_production_2026"
JWT_TEMP_2FA_SECRET="kts_crm_temp_2fa_secret_key_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_TEMP_2FA_EXPIRES_IN="5m"

# 2FA Google Mail (SMTP) Configuration
# Use a Google Workspace or Gmail Account with a 16-character App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-company-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM="KTS CRM Security <your-company-email@gmail.com>"
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# External API Gateway Security (/api/v1/external/*)
# Used by Cloud Attendance Software & External Payroll Software via Cloudflare WAF
EXTERNAL_API_KEY="kts_ext_api_key_cloud_attendance_payroll_2026"
EXTERNAL_HMAC_SECRET="kts_ext_hmac_sha256_secret_2026"
EXTERNAL_IP_WHITELIST="127.0.0.1,::1,10.10.20.0/24"

# NAS Storage Integration (VLAN 20: 10.10.20.250)
NAS_CONTRACT_PDF_MOUNT_PATH="./storage/nas/contracts"
NAS_BACKUP_MOUNT_PATH="./storage/nas/backups"
